msgstr ""
"\" Bien mieux. Mais j'aimerais recccevoir une confirmation supplémentaire de"
" la sssincérité de tes intentionsss. \""

#: src-en/data/events_special_eg_miracle_seekers.xml:3812
msgid ""
"data/events_special_eg_miracle_seekers.xml$//event[@name=\"EG_QUEST_THANKS_2\"]/choice/event/choice[2]/event/choice[1]/event/choice[1]/event/choice[1]/text"
