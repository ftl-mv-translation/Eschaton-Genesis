"\t\t\t\t\t\t\t\n"
"\t\t\t\t\t\t\tVous dites au revoir au propriétaire du restaurant, qui essuie la sueur de son front. Vous avez fait une bonne action."

#: src-en/data/events_special_miracleseekers.xml:1816
msgid ""
"data/events_special_miracleseekers.xml$//event[@name=\"EG_QUEST_TERMITES_EATERY_CONTINUE\"]/choice[3]/event/choice/event/choice/text"
