#: src-en/data/events_special_miracleseekers.xml:1832
msgid ""
"data/events_special_miracleseekers.xml$//event[@name=\"EG_QUEST_TERMITES_EATERY_CONTINUE\"]/choice[4]/text"
msgstr "Vous excuser auprès des termites et vous enfuir."

#: src-en/data/events_special_miracleseekers.xml:1834
msgid ""
"data/events_special_miracleseekers.xml$//event[@name=\"EG_QUEST_TERMITES_EATERY_CONTINUE\"]/choice[4]/event/text"
msgstr ""
"Il semble que vous n'ayez pas assez de ferraille à donner aux termites. Vous"
" leur dites au revoir, ainsi qu'au propriétaire du restaurant, le laissant "
"gérer le problème seul."

#: src-en/data/events_special_miracleseekers.xml:1836
msgid ""
"data/events_special_miracleseekers.xml$//event[@name=\"EG_QUEST_TERMITES_EATERY_CONTINUE\"]/choice[4]/event/choice/text"
