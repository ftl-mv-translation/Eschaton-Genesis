#: src-en/data/events_special_miracleseekers.xml:267
msgid ""
"data/events_special_miracleseekers.xml$//event[@name=\"MIRACLE_SEEKERS_LOBBY\"]/choice[@req=\"seekers_quest_started\"]/event/choice[2]/text"
