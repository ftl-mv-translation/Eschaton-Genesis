#: src-en/data/events_special_miracleseekers.xml:88
msgid ""
"data/events_special_miracleseekers.xml$//event[@name=\"EG_MIRACLE_SEEKERS_STATION\"]/choice[@req=\"miracle_seekers_metarep\""
" and @lvl=\"1\"]/event/text"
msgstr ""
