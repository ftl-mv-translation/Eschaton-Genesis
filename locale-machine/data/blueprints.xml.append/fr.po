#: src-en/data/blueprints.xml.append:103
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"EG_ROBUR_ARMOR\"]/desc"
msgstr ""
"La Plaque de Blindage s'attache à votre vaisseau, empêchant les dégâts à la "
"coque avec 5 % de chance et les dégâts aux systèmes avec 10 % de chance. "
"Elle peut être intégrée au vaisseau via le menu de stockage afin qu'elle "
"n'occupe pas d'emplacement d'augmentation."

#: src-en/data/blueprints.xml.append:111
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"EG_ROBUR_ARMOR_INTERNAL\"]/title"
msgstr "Plaque de Blindage"

#: src-en/data/blueprints.xml.append:112
