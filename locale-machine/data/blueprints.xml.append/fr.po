#: src-en/data/blueprints.xml.append:402
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"EG_GEM_VIOLET\"]/desc"
msgstr ""
"Lorsqu'une arme ennemie frappe la coque de votre vaisseau, un puissant éclat"
" de pierre précieuse de sugilite s'en détache. Il inflige 3 dégâts ioniques "
"et 1 dégât à la coque. L'éclat touche presque toujours la cible. De plus, "
"votre vaisseau a 50 % de chances d'ignorer les dégâts ioniques."

#: src-en/data/blueprints.xml.append:408
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"EG_GEM_CYAN\"]/title"
