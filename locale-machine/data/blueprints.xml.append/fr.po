msgid "data/blueprints.xml.append$//augBlueprint[@name=\"EG_BATTERY_PACK\"]/desc"
msgstr ""
"Ce pack contient évidemment des batteries. Vous pouvez le vendre pour 65 "
"ferraille, ou le garder pour obtenir +7 % à la recharge de votre bouclier et"
" +5 % à la recharge de votre arme."

#: src-en/data/blueprints.xml.append:293
