#: src-en/data/blueprints.xml.append:16
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"EG_ROBUR_ARMOR\"]/title"
msgstr "Plaque de blindage"

#: src-en/data/blueprints.xml.append:17
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"EG_ROBUR_ARMOR\"]/desc"
msgstr ""
"La plaque de blindage s'attache à votre vaisseau, prévenant les dégâts à la "
"coque avec 5 % de chances et les dégâts aux systèmes avec 10 % de chances. "
"Elle peut être intégrée au vaisseau via le menu de stockage afin de ne pas "
"occuper un emplacement d'augmentation."

#: src-en/data/blueprints.xml.append:25
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"EG_ROBUR_ARMOR_INTERNAL\"]/title"
msgstr "Plaque de blindage"

#: src-en/data/blueprints.xml.append:26
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"EG_ROBUR_ARMOR_INTERNAL\"]/desc"
msgstr ""
"La plaque de blindage s'attache à votre vaisseau, prévenant les dégâts à la "
