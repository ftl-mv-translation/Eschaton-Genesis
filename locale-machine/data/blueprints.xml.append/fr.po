#: src-en/data/blueprints.xml.append:416
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"EG_GEM_CORAL\"]/desc"
msgstr ""
"Lorsqu'une arme ennemie frappe la coque de votre vaisseau, un puissant éclat"
