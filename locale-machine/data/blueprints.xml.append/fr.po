#: src-en/data/blueprints.xml.append:285
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"EG_TERMITE_COLONY\"]/title"
msgstr "Colonie de Termites"

#: src-en/data/blueprints.xml.append:286
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"EG_TERMITE_COLONY\"]/desc"
msgstr ""
"Les termites voyagent sur des bio-vaisseaux scarabées. Leurs vaisseaux ont "
"un certain degré de régénération, guérissant automatiquement les brèches, "
"éteignant les incendies et réparant les systèmes. Les épaisses carapaces "
"chitineuses des scarabées leur donnent +15 % de chance d'ignorer les dégâts "
"à la coque. Seules les races insectoïdes sont capables de se déplacer entre "
"les scarabées."

