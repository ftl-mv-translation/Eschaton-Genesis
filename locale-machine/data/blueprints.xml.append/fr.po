#: src-en/data/blueprints.xml.append:173
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"EG_LESSER_GUARDIAN_ASB\"]/title"
msgstr "Imprimante de plate-forme ASB"

#: src-en/data/blueprints.xml.append:174
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"EG_LESSER_GUARDIAN_ASB\"]/desc"
msgstr ""
"Avant la bataille, votre vaisseau peut lancer une plate-forme ASB auto-"
"déployante pour attaquer vos ennemis à divers coûts : 3 cellules de "
"carburant, 2 missiles ou 2 pièces de drones. Vous pouvez également installer"
" un Collecteur de ferraille ou un Bras magnétique et lancer la plate-forme "
"gratuitement."

