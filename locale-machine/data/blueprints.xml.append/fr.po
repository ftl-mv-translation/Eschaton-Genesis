#: src-en/data/blueprints.xml.append:7
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"EG_DREAM_SEEKER_HEART\"]/desc"
msgstr ""
"Permet à votre équipage d'ignorer le contrôle mental. Votre propre contrôle "
