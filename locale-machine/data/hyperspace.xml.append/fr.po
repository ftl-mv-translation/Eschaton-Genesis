#: src-en/data/hyperspace.xml.append:322
msgid ""
"data/hyperspace.xml.append$//mod-"
"append:race[@name=\"unique_mirrored\"]/powerEffect/tooltip"
msgstr ""
"[TEMPS DE RECHARGE : 55s]\n"
"\t\t\t\tPermet au vaisseau d'ignorer les dégâts aux systèmes avec 50 % de chances et les dégâts à la coque avec 100 % de chances (sauf les dégâts de sabotage) pendant 7 secondes."

